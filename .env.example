# Copy this file to .env.local and fill in the values.
# Leave the Supabase values empty to run the site in demo mode (sample data, no accounts needed).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Public address of the live site, used for SEO tags and the sitemap
VITE_SITE_URL=https://www.example.com
# Google Analytics 4 measurement ID (looks like G-XXXXXXX). Optional.
VITE_GA_ID=
# Social links shown in the footer. Optional.
VITE_INSTAGRAM_URL=
VITE_FACEBOOK_URL=
VITE_YOUTUBE_URL=
# Set to true once payments (Stripe or another service) are connected. Until then paid lessons show "Coming soon".
VITE_PAYMENTS_ENABLED=
